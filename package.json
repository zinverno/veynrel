{
  "name": "obsidian-ai-hub",
  "version": "1.9.0",
  "description": "Veynrel: semantic search and AI-assisted knowledge workflows for Obsidian.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "node esbuild.config.mjs production",
    "lint": "npm run lint:obsidian",
    "lint:obsidian": "npm run typecheck && npm run build && node scripts/lint-obsidian.mjs",
    "typecheck": "tsc --noEmit --module ES2020 --ignoreDeprecations 5.0 && tsc --project health/tsconfig.json",
    "test": "vitest run",
    "version": "node version-bump.mjs && git add manifest.json versions.json",
    "audit:proposals": "node scripts/proposal-mutation-audit.mjs",
    "companion:smoke-sibling": "node scripts/companion-smoke-sibling.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^20.11.0",
    "esbuild": "0.19.11",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "0.4.2",
    "globals": "^17.11.0",
    "obsidian": "latest",
    "tslib": "2.6.2",
    "typescript": "5.3.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10"
  }
}
