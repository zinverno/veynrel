{
  "name": "obsidian-ai-hub",
  "version": "1.7.0",
  "description": "AI Hub for Obsidian",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "node esbuild.config.mjs production",
    "lint": "npm run lint:obsidian && npm --prefix companion run lint",
    "lint:obsidian": "npm run typecheck && npm run build && node scripts/lint-obsidian.mjs",
    "typecheck": "tsc --noEmit --module ES2020 --ignoreDeprecations 5.0",
    "test": "vitest run --exclude 'companion/**'",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^20.11.0",
    "esbuild": "0.19.11",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "0.4.2",
    "globals": "^17.11.0",
    "obsidian": "latest",
    "tslib": "2.6.2",
    "typescript": "5.3.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10"
  }
}
